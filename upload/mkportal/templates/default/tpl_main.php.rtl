		  {$blocks}
		  </table>
		</td>

<!-- end center column -->
		
EOF;
}

function view_column_right($blocks) {
global $mklib;
return <<<EOF

<!-- begin right column -->

		<td id="menudx" valign="top">
		<div id="menucontentr" class="mkalign1" style="$mklib->menucontentr">
		<div class="mkalign1">&nbsp;<a href="javascript:ColumnClose('menudx');MemoPos('MKmenudx', '1')"><img src="$mklib->images/f1.gif" border="0" alt="" /></a></div>
		  <table cellpadding="0" cellspacing="2" border="0" style="width: {$mklib->columnwidth}px;">
		  {$blocks}
		  </table>
		</div>
		<div id="menuclosedr" style="$mklib->menuclosedr">
		<div class="mkalign1"><a href="javascript:ColumnOpen('menudx');MemoPos('MKmenudx', '0')"><img src="$mklib->images/f2.gif" border="0" alt="" /></a></div>
		</div>
		</td>
		
<!-- end right column -->

EOF;
}

